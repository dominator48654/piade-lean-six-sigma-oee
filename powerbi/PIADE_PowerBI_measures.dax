// =====================================================================
// PIADE Lean Six Sigma - Power BI model (DAX measures + Power Query)
// Source: PostgreSQL database "piade", schema "piade" (views from sql/02)
// =====================================================================

// ---------------------------------------------------------------------
// 1. POWER QUERY (Home > Get data > PostgreSQL; needs the Npgsql driver)
//    Import these objects. Paste each into Advanced Editor if you prefer.
// ---------------------------------------------------------------------
// let Source = PostgreSQL.Database("localhost", "piade"),
//     T = Source{[Schema="piade", Item="v_daily_machine"]}[Data]
// in  T
//
// Import:  v_daily_machine      -> rename fact_daily
//          f_downtime_event     -> rename fact_stops
//          v_shift_oee          -> rename fact_shift
//          v_xbar_r_chart       -> rename spc_xbar_r
//          v_pareto_alarm       -> rename dim_alarm
//          v_loss_tree          -> rename loss_tree
//          v_inventory_policy   -> rename inv_policy
//          dim_machine, dim_date
// No database? Use the CSVs in outputs/powerbi or the x_*.csv exports instead.

// ---------------------------------------------------------------------
// 2. RELATIONSHIPS (single direction, one-to-many)
// ---------------------------------------------------------------------
// dim_machine[equipment_id] 1 -> * fact_daily[equipment_id], fact_stops[equipment_id],
//                                   fact_shift[equipment_id], spc_xbar_r[equipment_id], inv_policy[equipment_id]
// dim_date[date_key]        1 -> * fact_daily[prod_date], fact_stops[prod_date],
//                                   fact_shift[prod_date], spc_xbar_r[prod_date]
// dim_alarm[alarm]          1 -> * fact_stops[alarm]
// Mark dim_date as the date table.

// ---------------------------------------------------------------------
// 3. CORE OEE MEASURES  (table: fact_daily)
// ---------------------------------------------------------------------
Planned Hours   = DIVIDE ( SUM ( fact_daily[planned_s] ), 3600 )
Run Hours       = DIVIDE ( SUM ( fact_daily[run_s] ), 3600 )
Idle Hours      = DIVIDE ( SUM ( fact_daily[idle_s] ), 3600 )
Downtime Hours  = DIVIDE ( SUM ( fact_daily[downtime_s] ), 3600 )
Scheduled Hours = DIVIDE ( SUM ( fact_daily[scheduled_downtime_s] ), 3600 )

Availability = DIVIDE ( [Run Hours], [Planned Hours] )
Performance  = MIN ( 1, DIVIDE ( SUM ( fact_daily[units_in] ), SUM ( fact_daily[ideal_run_units] ) ) )
Quality      = DIVIDE ( SUM ( fact_daily[units_out] ), SUM ( fact_daily[units_in] ) )
OEE          = [Availability] * [Performance] * [Quality]

OEE Target        = 0.65
OEE Gap (pts)     = ( [OEE] - [OEE Target] ) * 100
Idle Share        = DIVIDE ( [Idle Hours], [Planned Hours] )
Downtime Share    = DIVIDE ( [Downtime Hours], [Planned Hours] )
Speed Loss Hours  = [Run Hours] * ( 1 - [Performance] )
Quality Loss Hours = [Run Hours] * [Performance] * ( 1 - [Quality] )
Fully Productive Hours = [Planned Hours] * [OEE]

Rejects  = SUM ( fact_daily[units_in] ) - SUM ( fact_daily[units_out] )
DPMO     = DIVIDE ( [Rejects], SUM ( fact_daily[units_in] ) ) * 1000000
Sigma Level (ST) = NORM.S.INV ( 1 - DIVIDE ( [DPMO], 1000000 ) ) + 1.5

OEE PY = CALCULATE ( [OEE], SAMEPERIODLASTYEAR ( dim_date[date_key] ) )
OEE YoY (pts) = ( [OEE] - [OEE PY] ) * 100

// ---------------------------------------------------------------------
// 4. STOPS, PARETO, RELIABILITY  (table: fact_stops)
// ---------------------------------------------------------------------
Stops            = COUNTROWS ( fact_stops )
Stop Hours       = DIVIDE ( SUM ( fact_stops[duration_s] ), 3600 )
MTTR (min)       = DIVIDE ( SUM ( fact_stops[duration_s] ) / 60, [Stops] )
MTBF (run-min)   = DIVIDE ( [Run Hours] * 60, [Stops] )
Stops per Run-h  = DIVIDE ( [Stops], [Run Hours] )

Pareto Cum % =
VAR CurH = [Stop Hours]
VAR Tbl  = ADDCOLUMNS ( ALLSELECTED ( dim_alarm[alarm] ), "@h", [Stop Hours] )
VAR Cum  = SUMX ( FILTER ( Tbl, [@h] >= CurH ), [@h] )
RETURN DIVIDE ( Cum, SUMX ( Tbl, [@h] ) )

Pareto Class =
VAR c = [Pareto Cum %] - DIVIDE ( [Stop Hours], CALCULATE ( [Stop Hours], ALLSELECTED ( dim_alarm[alarm] ) ) )
RETURN IF ( c < 0.8, "A", IF ( c < 0.95, "B", "C" ) )

// ---------------------------------------------------------------------
// 5. X-BAR / R CHART  (table: spc_xbar_r; limits computed in SQL from Phase I)
//    Line chart: axis = prod_date; values = X-bar, CL, UCL X, LCL X
//    Second chart: R, R-bar, UCL R.  Filter equipment_id = s_1.
// ---------------------------------------------------------------------
X-bar   = AVERAGE ( spc_xbar_r[xbar] )
R       = AVERAGE ( spc_xbar_r[r] )
CL      = AVERAGE ( spc_xbar_r[xbarbar] )
UCL X   = AVERAGE ( spc_xbar_r[ucl_x] )
LCL X   = MAX ( 0, AVERAGE ( spc_xbar_r[lcl_x] ) )
R-bar   = AVERAGE ( spc_xbar_r[rbar] )
UCL R   = AVERAGE ( spc_xbar_r[ucl_r] )
Out of Control Flag = IF ( MAX ( spc_xbar_r[x_rule1_out] ) || MAX ( spc_xbar_r[r_rule1_out] ), 1, 0 )
Run Rule Flag       = IF ( MAX ( spc_xbar_r[x_rule_8_same_side] ), 1, 0 )
// Conditional formatting on markers: red when [Out of Control Flag] = 1, orange when [Run Rule Flag] = 1.
// NOTE: sql/02 computes Pass-1 limits on all of 2020. The Excel tab C1 shows the revised
// limits after removing assignable-cause points - copy those 5 numbers into a small
// 'spc_limits' table if you want the revised version in Power BI.

// ---------------------------------------------------------------------
// 6. INVENTORY WHAT-IF (Modeling > New parameter > Numeric range)
//    Service Level = GENERATESERIES ( 0.90, 0.995, 0.005 )  -> slicer
// ---------------------------------------------------------------------
Lead Time Days    = 7
Lead Time SD Days = 1.5
Order Cost INR    = 6000
Holding Cost INR  = 4 * 0.24
z                 = NORM.S.INV ( SELECTEDVALUE ( 'Service Level'[Service Level], 0.98 ) )
Mean Daily Demand = AVERAGE ( inv_policy[mean_daily] )
SD Daily Demand   = AVERAGE ( inv_policy[sd_daily] )
Sigma LTD         = SQRT ( [Lead Time Days] * [SD Daily Demand] ^ 2 + [Mean Daily Demand] ^ 2 * [Lead Time SD Days] ^ 2 )
Safety Stock      = [z] * [Sigma LTD]
Reorder Point     = [Mean Daily Demand] * [Lead Time Days] + [Safety Stock]
EOQ               = SQRT ( 2 * [Mean Daily Demand] * 365 * [Order Cost INR] / [Holding Cost INR] )
Avg Inventory     = [EOQ] / 2 + [Safety Stock]
Annual Inv Cost   = [Holding Cost INR] * [Avg Inventory] + DIVIDE ( [Mean Daily Demand] * 365, [EOQ] ) * [Order Cost INR]

// ---------------------------------------------------------------------
// 7. REPORT PAGES (suggested)
// ---------------------------------------------------------------------
// P1 OEE cockpit   : cards (OEE, A, P, Q, Gap), OEE by machine (bar + target line), monthly OEE (line), slicers machine/date/shift
// P2 Loss tree     : Decomposition tree on loss_tree[hours]; waterfall of Planned -> losses -> Fully productive
// P3 Pareto & RCA  : Pareto combo (Stop Hours bars + Pareto Cum % line), matrix alarm x machine (heat-map formatting), MTBF/MTTR bars
// P4 Shift & idle  : matrix hour x weekday of Idle Share, Idle Share by shift, weekend vs weekday
// P5 SPC           : X-bar chart + R chart for s_1 with limits and flagged points
// P6 Inventory     : Service Level slicer; SS / ROP / EOQ by machine; cost vs service-level line
